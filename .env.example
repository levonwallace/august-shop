# Copy to .env (git-ignored). Values come from Shopify admin → Sales channels
# → Headless → Storefront API. Only the dev server and scripts read these; the
# private token never reaches the browser.

# august-shop.myshopify.com (or the custom domain)
SHOPIFY_STORE_DOMAIN=

# Prefer the private token for server-side use; the public one also works.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# Optional
SHOPIFY_API_VERSION=2026-07
# How many newest in-stock products the prototype loads as its catalog
SHOPIFY_PROTOTYPE_LIMIT=250
