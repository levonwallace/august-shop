[
  {
    "name": "theme_info",
    "theme_name": "August 2.1",
    "theme_version": "2.1.0",
    "theme_author": "August × Scissor Studio",
    "theme_documentation_url": "https://github.com/levonwallace/august-shop",
    "theme_support_url": "https://august-shop.com"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Square PNG, at least 180×180. Falls back to the August SVG."
      },
      {
        "type": "image_picker",
        "id": "og_image",
        "label": "Social share image",
        "info": "1200×630. Used when a page has no image of its own."
      },
      {
        "type": "image_picker",
        "id": "avatar_default",
        "label": "Default avatar",
        "info": "Shown in the header and on the account page."
      }
    ]
  },
  {
    "name": "Catalog",
    "settings": [
      {
        "type": "paragraph",
        "content": "Collections that power the home card stack, filters and the Radio card — pre-set to the live store’s handles. Navigation (mega menu, footer) comes from the main-menu, shop and socials menus under Online Store → Navigation. Optional product tags dept:men / dept:women and cat:shoes / cat:apparel / cat:accessories / cat:objects refine filtering (falls back to product type)."
      },
      {
        "type": "collection",
        "id": "everything_collection",
        "label": "Everything",
        "info": "Defaults to all products."
      },
      {
        "type": "collection",
        "id": "new_collection",
        "label": "New arrivals",
        "info": "Live handle: new-arrivals"
      },
      {
        "type": "collection",
        "id": "sale_collection",
        "label": "Sale",
        "info": "Live handle: sale"
      },
      {
        "type": "collection",
        "id": "footwear_collection",
        "label": "Footwear",
        "info": "Live handle: footwear"
      },
      {
        "type": "collection",
        "id": "apparel_collection",
        "label": "Apparel",
        "info": "Live handle: apparel"
      },
      {
        "type": "collection",
        "id": "accessories_collection",
        "label": "Accessories",
        "info": "Live handle: accessories"
      },
      {
        "type": "collection",
        "id": "objects_collection",
        "label": "Objects",
        "info": "Live handle: objects"
      },
      {
        "type": "header",
        "content": "Editorial"
      },
      {
        "type": "blog",
        "id": "aux_blog",
        "label": "AUX mixes blog",
        "info": "Live handle: august-aux (mixes ≤075; 076–078 are still in “news”)"
      },
      {
        "type": "blog",
        "id": "events_blog",
        "label": "Events blog",
        "info": "Live handle: events"
      },
      {
        "type": "page",
        "id": "inn_page",
        "label": "August Inn page",
        "info": "Assign this page the “August Inn” template too. Leave empty to use the blog below."
      },
      {
        "type": "blog",
        "id": "inn_blog",
        "label": "August Inn blog",
        "info": "The live store runs the Inn as a blog on the “inn” template; this theme renders it with the Inn section."
      },
      {
        "type": "textarea",
        "id": "soundcloud_map",
        "label": "SoundCloud track IDs",
        "info": "One per line, mix number = track id (078=1982757851). Used when an AUX article has no august.soundcloud_track_id metafield."
      },
      {
        "type": "header",
        "content": "Product cards"
      },
      {
        "type": "checkbox",
        "id": "card_sale_badge",
        "label": "Show a “Sale” badge on discounted cards",
        "default": true,
        "info": "Cards always show theme.badge / Pre-order first (the live store’s metafields)."
      }
    ]
  },
