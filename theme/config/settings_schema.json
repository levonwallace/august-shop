  {
    "name": "Typography & chrome",
    "settings": [
      {
        "type": "text",
        "id": "font_stack",
        "label": "Font stack",
        "info": "CSS font-family list. Leave blank for Helvetica Neue.",
        "default": ""
      },
      {
        "type": "range",
        "id": "ui_scale",
        "min": 60,
        "max": 100,
        "step": 5,
        "unit": "%",
        "label": "Desktop UI scale",
        "default": 75
      },
      {
        "type": "range",
        "id": "radius_card",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "Card radius",
        "default": 6
      },
      {
        "type": "range",
        "id": "radius_chrome",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "Chrome radius",
        "default": 8
      }
    ]
  },
  {
    "name": "Announcement",
    "settings": [
      {
        "type": "checkbox",
        "id": "announce_enable",
        "label": "Show announcement chip",
        "default": true
      },
      {
        "type": "text",
        "id": "announce_text",
        "label": "Announcement",
        "default": "Back to school sale"
      },
      {
        "type": "url",
        "id": "announce_link",
        "label": "Announcement link"
      }
    ]
  },
  {
    "name": "Pickup store",
    "settings": [
      {
        "type": "text",
        "id": "store_name",
        "label": "Store name",
        "default": "August"
      },
      {
        "type": "text",
        "id": "store_address",
        "label": "Address",
        "default": "414 State St, Madison, WI 53703",
        "info": "Comma-separated; the street is used on its own in short copy."
      },
      {
        "type": "text",
        "id": "store_hours",
        "label": "Hours",
        "default": "Mon–Sat 11–7 · Sun 12–5"
      },
      {
        "type": "url",
        "id": "store_map_url",
        "label": "Map link"
      },
      {
        "type": "text",
        "id": "store_lat",
        "label": "Latitude",
        "default": "43.07492"
      },
      {
        "type": "text",
        "id": "store_lng",
        "label": "Longitude",
        "default": "-89.38755"
      }
    ]
  },
  {
    "name": "Offer popup",
    "settings": [
      {
        "type": "checkbox",
        "id": "offer_enable",
        "label": "Show welcome offer",
        "default": true
      },
      {
        "type": "text",
        "id": "offer_eyebrow",
        "label": "Eyebrow",
        "default": "Welcome offer"
      },
      {
        "type": "text",
        "id": "offer_heading",
        "label": "Heading",
        "default": "10% off"
      },
      {
        "type": "text",
        "id": "offer_lede",
        "label": "Lede",
        "default": "Your first order — pickup on State Street or checkout."
      },
      {
        "type": "text",
        "id": "offer_code",
        "label": "Discount code",
        "default": "AUGUST10",
        "info": "Create the matching code under Discounts."
      },
      {
        "type": "text",
        "id": "offer_success",
        "label": "Success message",
        "default": "Code AUGUST10 — applied at pickup or checkout."
      },
      {
        "type": "text",
        "id": "offer_fine",
