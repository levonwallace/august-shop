<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">{%- else %}<link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">{%- endif %}
    {% render 'css-variables' %}
    {{ 'tokens.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ 'pages.css' | asset_url | stylesheet_tag }}
    {{ 'profile.css' | asset_url | stylesheet_tag }}
    {{ 'account.css' | asset_url | stylesheet_tag }}
    {{ 'theme-live.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <div class="page page--account">
      {{ content_for_layout }}
    </div>
  </body>
</html>
