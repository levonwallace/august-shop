{% comment %} Prototype: footer.site-footer (every page) {% endcomment %}
<footer class="site-footer" data-section-id="{{ section.id }}">
  <div class="footer-brand">
    {%- if section.settings.logo -%}
      <img class="footer-brand__logo" src="{{ section.settings.logo | image_url: width: 240 }}" alt="{{ shop.name | escape }}" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}">
    {%- else -%}
      <img class="footer-brand__logo" src="{{ 'footer-logo.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="600" height="600">
    {%- endif -%}
    {%- if section.settings.tagline != blank -%}
      <span class="footer-brand__tag">{{ section.settings.tagline }}</span>
    {%- endif -%}
  </div>
  <nav class="footer-links" aria-label="Footer">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- else -%}
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      {%- assign inn_url = pages[settings.inn_page].url | default: blogs[settings.inn_blog].url -%}
      {%- if inn_url != blank -%}<a href="{{ inn_url }}">August Inn</a>{%- endif -%}
    {%- endfor -%}
  </nav>
  {%- if section.settings.show_social -%}
    {%- liquid
      comment
        Social links: the store's `socials` menu first (same source as the
        live theme's footer), then Theme settings → Social as a fallback.
      endcomment
      assign social_menu = linklists[section.settings.social_menu]
      assign socials = ''
      if social_menu != blank and social_menu.links.size > 0
        for link in social_menu.links
          assign socials = socials | append: link.title | append: '|' | append: link.url | append: ','
        endfor
      else
        if settings.social_instagram != blank
          assign socials = socials | append: 'Instagram|' | append: settings.social_instagram | append: ','
        endif
        if settings.social_soundcloud != blank
          assign socials = socials | append: 'SoundCloud|' | append: settings.social_soundcloud | append: ','
        endif
        if settings.social_spotify != blank
          assign socials = socials | append: 'Spotify|' | append: settings.social_spotify | append: ','
        endif
        if settings.social_facebook != blank
          assign socials = socials | append: 'Facebook|' | append: settings.social_facebook | append: ','
        endif
        if settings.social_twitter != blank
          assign socials = socials | append: 'X|' | append: settings.social_twitter | append: ','
        endif
        if settings.social_vimeo != blank
          assign socials = socials | append: 'Vimeo|' | append: settings.social_vimeo | append: ','
        endif
      endif
      assign social_list = socials | split: ','
    -%}
    {%- if social_list.size > 0 -%}
      <nav class="footer-links footer-links--social" aria-label="Social">
        {%- for item in social_list -%}
          {%- assign pair = item | split: '|' -%}
          {%- if pair.size == 2 -%}<a href="{{ pair.last }}" target="_blank" rel="noopener">{{ pair.first }}</a>{%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  {%- endif -%}
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "shopify-section-footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Falls back to the August wordmark SVG." },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Streetwear, sneakers, art & music — Madison, WI."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu",
      "default": "shop",
      "info": "The live store's “shop” menu: Contact, Policies, Returns, Security."
    },
    { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": true },
    {
      "type": "link_list",
      "id": "social_menu",
      "label": "Social menu",
      "default": "socials",
      "info": "Falls back to Theme settings → Social when this menu is empty."
    }
  ]
}
{% endschema %}
