{% comment %}
  Prototype: header.site-header + morph-menu (mega) + mobile-nav in every page.

  Navigation comes from ONE nested menu (Online Store → Navigation), the same
  `main-menu` the live theme uses:
    top-level link            → nav item
    …with child links         → opens the morph menu with those links
    …with grandchildren       → directory grid (Brands "123 - F" …, Categories)
    …without children         → plain link
  Blocks:
    mega_panel — optional override for one top-level item (matched by label):
                 product tiles collection, editorial card, "view all" link,
                 or a computed brand / category directory.
    promo      — a tile in the mobile menu's "Featured" strip.
  main.js reads window.AugustMegaPanels (emitted below).
{% endcomment %}
{%- liquid
  assign avatar_src = 'avatar-demo.jpg' | asset_url
  if settings.avatar_default != blank
    assign avatar_src = settings.avatar_default | image_url: width: 66
  endif
  assign announce_href = settings.announce_link | default: routes.all_products_collection_url
  assign panel_blocks = section.blocks | where: 'type', 'mega_panel'
  assign promo_blocks = section.blocks | where: 'type', 'promo'
  assign nav_menu = linklists[section.settings.menu]
  if nav_menu == blank or nav_menu.links.size == 0
    assign nav_menu = linklists['main-menu']
  endif

  comment
    Work out which top-level links open a panel. "panel_keys" is a
    pipe-separated list of handleized labels; the first one seeds the
    server-rendered panel body.
  endcomment
  assign panel_keys = ''
  for link in nav_menu.links
    assign key = link.title | handleize
    assign has_panel = false
    if link.links.size > 0
      assign has_panel = true
    endif
    for block in panel_blocks
      assign block_key = block.settings.title | handleize
      if block_key == key
        comment
          An extras block turns a childless item (e.g. New Arrivals) into a
          panel when it brings a directory, a replacement menu, product
          tiles or an editorial card.
        endcomment
        if block.settings.directory != 'none' or block.settings.menu != blank or block.settings.products_collection != blank or block.settings.editorial_title != blank
          assign has_panel = true
        endif
      endif
    endfor
    if has_panel
      assign panel_keys = panel_keys | append: key | append: '|'
    endif
  endfor
  assign panel_key_list = panel_keys | split: '|'
  assign first_key = panel_key_list | first

  assign first_link = nil
  assign first_block = nil
  for link in nav_menu.links
    assign key = link.title | handleize
    if key == first_key
      assign first_link = link
      for block in panel_blocks
        assign block_key = block.settings.title | handleize
        if block_key == key
          assign first_block = block
        endif
      endfor
    endif
  endfor
  capture first_title
    render 'nav-label', title: first_link.title
  endcapture
  assign first_title = first_title | strip
  assign first_href = first_block.settings.all_link | default: first_link.url | default: routes.all_products_collection_url
  assign first_all = first_block.settings.all_label
  if first_all == blank
    assign lowered = first_title | downcase
    assign first_all = 'Shop all ' | append: lowered | append: ' →'
  endif
  assign first_links = first_block.settings.menu.links | default: first_link.links
  assign mega_source = first_block.settings.products_collection
  if mega_source == blank and first_link.type == 'collection_link'
    assign mega_source = first_link.object
  endif
-%}

<header class="site-header" data-section-id="{{ section.id }}">
  <div class="header-mobile">
    <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" data-nav-toggle>{{ section.settings.menu_label }}</button>
    <a class="wordmark" href="{{ routes.root_url }}">{{ section.settings.wordmark | default: shop.name }}</a>
    <div class="header-mobile__actions">
      <img class="avatar" src="{{ avatar_src }}" width="33" height="33" alt="">
      <a href="{{ routes.cart_url }}" aria-label="Bag"><img class="icon-bag" src="{{ 'icon-bag.svg' | asset_url }}" alt="" width="600" height="600"></a>
    </div>
  </div>

  <div class="header-desktop">
    <div class="header-island header-nav" data-header-nav>
      <a class="wordmark" href="{{ routes.root_url }}">{{ section.settings.wordmark | default: shop.name }}</a>
      <nav class="nav-links" aria-label="Primary">
        {%- for link in nav_menu.links -%}
          {%- assign key = link.title | handleize -%}
          {%- if panel_key_list contains key -%}
            <button type="button" aria-expanded="false" data-mega-trigger="{{ key }}">{% render 'nav-label', title: link.title %}</button>
          {%- else -%}
            <a href="{{ link.url }}"{% if link.active %} class="is-active"{% endif %}>{% render 'nav-label', title: link.title %}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </div>

    {%- if settings.announce_enable and settings.announce_text != blank %}
      <div class="announce-wrap">
        <a class="announce-chip" href="{{ announce_href }}"><span class="dot" aria-hidden="true"></span>{{ settings.announce_text }}</a>
      </div>
    {%- endif %}

    <div class="header-island header-utilities">
      <form class="search-field" action="{{ routes.search_url }}" method="get" role="search">
        <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><circle cx="6" cy="6" r="4.25" stroke="currentColor" stroke-width="1.4"/><path d="M9.2 9.2L12 12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <input type="search" name="q" placeholder="{{ section.settings.search_placeholder }}" aria-label="Search" value="{{ search.terms | escape }}" autocomplete="off">
        <input type="hidden" name="type" value="product">
      </form>
      <div class="util-actions">
        <a href="{{ routes.cart_url }}" aria-label="Bag"><img class="icon-bag" src="{{ 'icon-bag.svg' | asset_url }}" alt="" width="600" height="600"></a>
        <img class="avatar" src="{{ avatar_src }}" width="33" height="33" alt="">
      </div>
    </div>
  </div>

  {%- comment %} Expanding mega menu — morph card {% endcomment -%}
  <div class="morph-menu" id="morph-menu" data-morph-menu aria-hidden="true">
    <div class="morph-menu__bar">
      <div class="morph-menu__cluster">
        <a class="wordmark" href="{{ routes.root_url }}">{{ section.settings.wordmark | default: shop.name }}</a>
        <nav class="morph-menu__nav" aria-label="Mega menu sections">
          {%- for link in nav_menu.links -%}
            {%- assign key = link.title | handleize -%}
            {%- if panel_key_list contains key -%}
              <button type="button" aria-expanded="false" data-mega-trigger="{{ key }}">{% render 'nav-label', title: link.title %}</button>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      </div>
      <button class="morph-menu__close" type="button" aria-label="Close menu" data-mega-close>
        <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </button>
    </div>
    <div class="morph-menu__divider" aria-hidden="true"></div>
    <div class="morph-menu__body">
      <div class="morph-links" data-mega-panel>
        <p class="morph-links__label" data-mega-label>{{ first_title }}</p>
        <div class="morph-links__list" data-mega-links>
          {%- for link in first_links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </div>
        <a class="morph-links__all" href="{{ first_href }}" data-mega-all>{{ first_all }}</a>
      </div>
      <div class="morph-products">
        {%- liquid
          if mega_source == blank or mega_source.products_count == 0
            assign mega_source = collections[settings.new_collection]
          endif
          if mega_source == blank or mega_source.products_count == 0
            assign mega_source = collections[settings.everything_collection]
          endif
          if mega_source == blank or mega_source.products_count == 0
            assign mega_source = collections.all
          endif
        -%}
        {%- for product in mega_source.products limit: 12 -%}
          <a class="mega-product" href="{{ product.url }}">
            <div class="mega-product__media">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 360 }}" alt="{{ product.title | escape }}" width="178" height="118" loading="lazy">
              {%- endif -%}
            </div>
            <span class="mega-product__price">{{ product.price | money }}</span>
            <span class="mega-product__title">{{ product.title }}</span>
          </a>
        {%- endfor -%}
      </div>
      <a class="morph-editorial" href="{{ first_block.settings.editorial_link | default: first_href }}" data-mega-editorial>
        <span class="morph-editorial__label" data-mega-editorial-label>{{ first_block.settings.editorial_label | default: 'Editorial' }}</span>
        <span class="morph-editorial__title" data-mega-editorial-title>{{ first_block.settings.editorial_title | default: first_title }}</span>
        <span class="morph-editorial__cta" data-mega-editorial-cta>{{ first_block.settings.editorial_cta | default: 'Explore →' }}</span>
      </a>
    </div>
  </div>

  {%- comment %} Mobile menu {% endcomment -%}
  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    {%- if settings.announce_enable and settings.announce_text != blank %}
      <a class="announce-chip announce-chip--mobile" href="{{ announce_href }}"><span class="dot" aria-hidden="true"></span>{{ settings.announce_text }}</a>
    {%- endif %}
    <form class="search-field search-field--mobile" action="{{ routes.search_url }}" method="get" role="search">
      <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><circle cx="6" cy="6" r="4.25" stroke="currentColor" stroke-width="1.4"/><path d="M9.2 9.2L12 12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      <input type="search" name="q" placeholder="{{ section.settings.search_placeholder }}" aria-label="Search" autocomplete="off">
      <input type="hidden" name="type" value="product">
    </form>
    <nav class="mobile-nav__links" aria-label="Mobile primary">
      {%- for link in nav_menu.links -%}
        {%- assign key = link.title | handleize -%}
        <a href="{{ link.url }}"{% if panel_key_list contains key %} data-mobile-dir="{{ key }}"{% endif %}>{% render 'nav-label', title: link.title %}</a>
      {%- endfor -%}
      {%- for link in section.settings.mobile_extra_menu.links -%}
        <a href="{{ link.url }}">{% render 'nav-label', title: link.title %}</a>
      {%- endfor -%}
      <a href="{{ routes.cart_url }}">Bag</a>
    </nav>
    {%- if promo_blocks.size > 0 %}
      <div class="mobile-nav__promos" aria-label="Featured">
        {%- for block in promo_blocks -%}
          <a class="mobile-nav__promo" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 480 }}" alt="" loading="lazy" width="480" height="480">
            {%- elsif block.settings.collection.featured_image -%}
              <img src="{{ block.settings.collection.featured_image | image_url: width: 480 }}" alt="" loading="lazy" width="480" height="480">
            {%- endif -%}
            <span>{{ block.settings.label | default: block.settings.collection.title }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif %}
  </div>
</header>

{%- comment %} Mega menu data for main.js {% endcomment -%}
<script>
  window.AugustMegaPanels = {
    {%- assign emitted = 0 -%}
    {%- for link in nav_menu.links -%}
      {%- assign key = link.title | handleize -%}
      {%- if panel_key_list contains key -%}
        {%- liquid
          assign ov = nil
          for block in panel_blocks
            assign block_key = block.settings.title | handleize
            if block_key == key
              assign ov = block
            endif
          endfor
          capture nav_label
            render 'nav-label', title: link.title
          endcapture
          assign nav_label = nav_label | strip
          assign all_label = ov.settings.all_label
          if all_label == blank
            assign lowered = nav_label | downcase
            assign all_label = 'Shop all ' | append: lowered | append: ' →'
          endif
          assign all_href = ov.settings.all_link | default: link.url | default: routes.all_products_collection_url
          assign panel_links = ov.settings.menu.links | default: link.links
          assign has_columns = false
          for child in link.links
            if child.links.size > 0
              assign has_columns = true
            endif
          endfor
          assign tiles = ov.settings.products_collection
          if tiles == blank and link.type == 'collection_link'
            assign tiles = link.object
          endif
        -%}
        {%- if emitted > 0 %},{% endif -%}
        {%- assign emitted = emitted | plus: 1 -%}
        {{ key | json }}: {
          label: {{ nav_label | json }},
          all: {{ all_label | json }},
          href: {{ all_href | json }},
          directory: {{ ov.settings.directory | default: 'none' | json }},
          links: [
            {%- for child in panel_links -%}
              { label: {{ child.title | json }}, href: {{ child.url | json }} }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ],
          columns: [
            {%- if has_columns -%}
              {%- for child in link.links -%}
                { head: {{ child.title | json }}, href: {{ child.url | json }}, items: [
                  {%- for grandchild in child.links -%}
                    { label: {{ grandchild.title | json }}, href: {{ grandchild.url | json }} }{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                ] }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            {%- endif -%}
          ],
          editorial: {
            label: {{ ov.settings.editorial_label | default: 'Editorial' | json }},
            title: {{ ov.settings.editorial_title | default: nav_label | json }},
            cta: {{ ov.settings.editorial_cta | default: 'Explore →' | json }},
            href: {{ ov.settings.editorial_link | default: all_href | json }}
          },
          products: [
            {%- for product in tiles.products limit: 12 -%}
              {%- render 'product-json-lite', product: product -%}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      {%- endif -%}
    {%- endfor -%}
  };
</script>

{% schema %}
{
  "name": "Header",
  "class": "shopify-section-header",
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "info": "Leave blank to use the store name.",
      "default": "August"
    },
    {
      "type": "text",
      "id": "menu_label",
      "label": "Mobile menu button",
      "default": "Menu"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu",
      "info": "Nested menu: items with sub-links open the mega menu; sub-sub-links become a directory grid (Brands, Categories)."
    },
    {
      "type": "link_list",
      "id": "mobile_extra_menu",
      "label": "Extra mobile links",
      "info": "Shown under the main items in the mobile menu (e.g. August Inn, Events)."
    },
    {
      "type": "paragraph",
      "content": "The announcement chip is a theme setting: Theme settings → Announcement."
    }
  ],
  "blocks": [
    {
      "type": "mega_panel",
      "name": "Menu item extras",
      "limit": 8,
      "settings": [
        { "type": "paragraph", "content": "Adds product tiles, an editorial card or a “view all” link to one item of the navigation menu. Links themselves live in Online Store → Navigation." },
        { "type": "text", "id": "title", "label": "Menu item label (must match)", "default": "New Arrivals" },
        {
          "type": "select",
          "id": "directory",
          "label": "Panel content",
          "default": "none",
          "options": [
            { "value": "none", "label": "Sub-links from the navigation menu" },
            { "value": "brands", "label": "Brand directory (all vendors, A–Z)" },
            { "value": "categories", "label": "Category directory (from product tags)" },
            { "value": "colors", "label": "Color picker (swatches match the colourway in product titles)" }
          ]
        },
        { "type": "link_list", "id": "menu", "label": "Replace sub-links with this menu" },
        { "type": "text", "id": "all_label", "label": "“View all” label" },
        { "type": "url", "id": "all_link", "label": "“View all” link" },
        { "type": "header", "content": "Product tiles" },
        { "type": "collection", "id": "products_collection", "label": "Collection for the product tiles (three rows of four)" },
        { "type": "header", "content": "Editorial card" },
        { "type": "text", "id": "editorial_label", "label": "Eyebrow", "default": "Editorial" },
        { "type": "textarea", "id": "editorial_title", "label": "Title" },
        { "type": "text", "id": "editorial_cta", "label": "Call to action", "default": "Explore →" },
        { "type": "url", "id": "editorial_link", "label": "Link" }
      ]
    },
    {
      "type": "promo",
      "name": "Mobile featured tile",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Fallback image + label when the fields above are empty." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "settings": { "menu": "main-menu" },
    "blocks": [
      { "type": "mega_panel", "settings": { "title": "New Arrivals", "editorial_title": "New\narrivals" } },
      { "type": "mega_panel", "settings": { "title": "Sale", "editorial_title": "Sale" } },
      { "type": "promo", "settings": { "label": "New arrivals" } },
      { "type": "promo", "settings": { "label": "Sale" } }
    ]
  }
}
{% endschema %}
