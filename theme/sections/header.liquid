{% comment %} Prototype: index.html header.site-header + morph-menu {% endcomment %}
<header class="site-header">
  <div class="header-mobile">
    <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" data-nav-toggle>Menu</button>
    <a class="wordmark" href="{{ routes.root_url }}">{{ shop.name }}</a>
    <div class="header-mobile__actions">
      <a href="{{ routes.cart_url }}" aria-label="Bag">
        <img class="icon-bag" src="{{ 'icon-bag.svg' | asset_url }}" alt="">
      </a>
    </div>
  </div>

  <div class="header-desktop">
    <div class="header-island header-nav" data-header-nav>
      <a class="wordmark" href="{{ routes.root_url }}">{{ shop.name }}</a>
      <nav class="nav-links" aria-label="Primary">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% else %}
          <a href="{{ routes.all_products_collection_url }}">New arrivals</a>
        {% endfor %}
      </nav>
    </div>
    {% if settings.announce_enable and settings.announce_text != blank %}
      <div class="announce-wrap">
        <a class="announce-chip" href="{{ settings.announce_link | default: routes.all_products_collection_url }}">
          <span class="dot" aria-hidden="true"></span>{{ settings.announce_text }}
        </a>
      </div>
    {% endif %}
    <div class="header-island header-utilities">
      <form class="search-field" action="{{ routes.search_url }}" method="get" role="search">
        <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><circle cx="6" cy="6" r="4.25" stroke="currentColor" stroke-width="1.4"/><path d="M9.2 9.2L12 12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <input type="search" name="q" placeholder="Search" aria-label="Search" value="{{ search.terms | escape }}">
      </form>
      <div class="util-actions">
        <a href="{{ routes.cart_url }}" aria-label="Bag">
          <img class="icon-bag" src="{{ 'icon-bag.svg' | asset_url }}" alt="">
        </a>
        <a href="{{ routes.account_url }}" aria-label="Account">Account</a>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
