{% comment %}
  Prototype: cart.html — swipe-to-remove lines, pickup/ship toggle,
  checkout. Liquid renders the lines; cart.js re-renders from the Ajax cart
  (shopify-bridge.js) and august-live.js writes the fulfilment preference
  to a cart attribute so it reaches checkout.
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign street = settings.store_address | split: ',' | first | default: settings.store_name
  assign pickup_note = s.pickup_note | replace: '[address]', street
  assign ship_note = s.ship_note | replace: '[address]', street
  assign empty_sub = s.empty_sub | replace: '[address]', street
-%}
<main class="cart-page" id="main" data-section-id="{{ section.id }}">
  <header class="cart-page__head">
    <h1>{{ s.heading }}</h1>
    <p class="cart-page__count" data-cart-count>{{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %}</p>
  </header>

  <div class="cart-empty" data-cart-empty{% if cart.item_count > 0 %} hidden{% endif %}>
    <h2 class="cart-empty__title">{{ s.empty_title }}</h2>
    <p class="cart-empty__sub">{{ empty_sub }}</p>
    <a class="btn btn--primary" href="{{ s.empty_link | default: routes.all_products_collection_url }}">{{ s.empty_cta }}</a>
  </div>

  <div class="cart-layout"{% if cart.item_count == 0 %} hidden{% endif %}>
    <div class="cart-lines" data-cart-list>
      {%- for item in cart.items -%}
        <div class="cart-swipe" data-cart-swipe data-cart-index="{{ forloop.index0 }}" data-line-key="{{ item.key }}">
          <div class="cart-swipe__actions" aria-hidden="true">
            <button class="cart-swipe__action cart-swipe__action--save" data-cart-save type="button" aria-label="Save for later">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4 3h10v13l-5-3-5 3V3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              <span>Save</span>
            </button>
            <button class="cart-swipe__action cart-swipe__action--delete" data-cart-remove type="button" aria-label="Remove">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 5h12M6 5V3.5A1.5 1.5 0 017.5 2h3A1.5 1.5 0 0112 3.5V5m1 0v9.5A1.5 1.5 0 0111.5 16h-5A1.5 1.5 0 015 14.5V5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              <span>Remove</span>
            </button>
          </div>
          <div class="cart-swipe__row cart-line">
            <div class="cart-line__thumb">{% if item.image %}<img src="{{ item.image | image_url: width: 240 }}" alt="" width="240" height="240">{% endif %}</div>
            <div class="cart-line__info">
              <div class="cart-line__brand">{{ item.vendor }}</div>
              <div class="cart-line__title"><a href="{{ item.url }}">{{ item.product.title }}</a></div>
              <div class="cart-line__meta">{% unless item.variant.title == 'Default Title' %}{{ item.variant.title }} · {% endunless %}Qty {{ item.quantity }}</div>
            </div>
            <div class="cart-line__price">{{ item.final_line_price | money }}</div>
          </div>
        </div>
      {%- endfor -%}
      <p class="cart-lines__hint">{{ s.swipe_hint }}</p>
    </div>

    <aside class="cart-summary" data-cart-summary>
      {%- if s.show_fulfill -%}
        <div class="segmented segmented--compact cart-fulfill" data-segmented data-cart-fulfill role="radiogroup" aria-label="Fulfillment">
          <span class="segmented__thumb" aria-hidden="true"></span>
          <button class="segmented__segment{% if cart.attributes.fulfillment != 'ship' %} is-active{% endif %}" type="button" role="radio" aria-checked="{% if cart.attributes.fulfillment != 'ship' %}true{% else %}false{% endif %}" data-value="pickup">{{ s.pickup_label }}</button>
          <button class="segmented__segment{% if cart.attributes.fulfillment == 'ship' %} is-active{% endif %}" type="button" role="radio" aria-checked="{% if cart.attributes.fulfillment == 'ship' %}true{% else %}false{% endif %}" data-value="ship">{{ s.ship_label }}</button>
        </div>
        <p class="cart-fulfill__note" data-cart-fulfill-note data-note-pickup="{{ pickup_note | escape }}" data-note-ship="{{ ship_note | escape }}">{% if cart.attributes.fulfillment == 'ship' %}{{ ship_note }}{% else %}{{ pickup_note }}{% endif %}</p>
      {%- endif -%}
      <div class="summary-row">
        <span>Subtotal</span><span data-cart-subtotal>{{ cart.items_subtotal_price | money }}</span>
      </div>
      <div class="summary-row summary-row--muted">
        <span data-cart-ship-label data-label-pickup="{{ s.pickup_label | escape }}" data-label-ship="Shipping">{{ s.pickup_label }}</span><span data-cart-ship-value data-value-pickup="Free" data-value-ship="At checkout">Free</span>
      </div>
      <div class="summary-row summary-row--muted">
        <span>Tax</span><span>At checkout</span>
      </div>
      <div class="summary-row summary-row--total">
        <span>Total</span><span data-cart-total>{{ cart.total_price | money }}</span>
      </div>
      <a href="/checkout" class="btn btn--primary btn--block{% if cart.item_count == 0 %} is-disabled{% endif %}" data-cart-checkout role="button">{{ s.checkout_label }}</a>
    </aside>
  </div>
</main>

{% schema %}
{
  "name": "Bag",
  "tag": "div",
  "class": "shopify-section-cart",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bag" },
    { "type": "text", "id": "swipe_hint", "label": "Swipe hint", "default": "Swipe left to save or remove" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button", "default": "Checkout" },
    { "type": "header", "content": "Pickup / ship", "info": "[address] is replaced with the street from Theme settings → Pickup store." },
    { "type": "checkbox", "id": "show_fulfill", "label": "Show pickup / ship toggle", "default": true },
    { "type": "text", "id": "pickup_label", "label": "Pickup label", "default": "Pickup" },
    { "type": "text", "id": "ship_label", "label": "Ship label", "default": "Ship" },
    { "type": "text", "id": "pickup_note", "label": "Pickup note", "default": "Ready at [address]. Usually same day." },
    { "type": "text", "id": "ship_note", "label": "Ship note", "default": "1–2 business days from [address]." },
    { "type": "header", "content": "Empty bag" },
    { "type": "text", "id": "empty_title", "label": "Title", "default": "Bag is empty" },
    { "type": "text", "id": "empty_sub", "label": "Subtitle", "default": "Pickup at [address] or ship nationwide." },
    { "type": "text", "id": "empty_cta", "label": "Button", "default": "Shop" },
    { "type": "url", "id": "empty_link", "label": "Button link" }
  ]
}
{% endschema %}
