{% comment %} Generic page in the story layout (Help, Shipping & returns, Visit…). {% endcomment %}
<main class="story story--page" id="main" data-section-id="{{ section.id }}">
  {%- if section.settings.kicker != blank -%}<p class="story__kicker">{{ section.settings.kicker }}</p>{%- endif -%}
  <h1 class="story__title">{{ page.title }}</h1>
  <div class="story__body">{{ page.content }}</div>
</main>

{% schema %}
{
  "name": "Page",
  "tag": "div",
  "class": "shopify-section-story",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "August" }
  ]
}
{% endschema %}
