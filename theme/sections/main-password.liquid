<main class="account-page" id="main" data-section-id="{{ section.id }}">
  <div class="account-gate">
    <div class="glass-panel account-gate__card">
      <p class="story__kicker">{{ shop.name }}</p>
      <h1>{{ section.settings.heading }}</h1>
      {%- if shop.password_message != blank -%}<p class="account-gate__why">{{ shop.password_message }}</p>{%- endif -%}
      {%- form 'storefront_password', class: 'profile-form' -%}
        {%- if form.errors -%}<p class="profile-form__error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <label class="profile-field">
          <span>Password</span>
          <input type="password" name="password" required autocomplete="current-password">
        </label>
        <button class="btn btn--primary btn--block profile-form__submit" type="submit">{{ section.settings.button }}</button>
      {%- endform -%}
      {%- if section.settings.show_newsletter -%}
        <h2 class="radio-newsletter__heading">{{ section.settings.newsletter_heading }}</h2>
        {%- form 'customer', class: 'aux-newsletter__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="aux-newsletter__done">Joined ✓</p>
          {%- else -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="email" name="contact[email]" placeholder="Email" aria-label="Email" required>
            <button type="submit">Join</button>
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</main>

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    { "type": "text", "id": "button", "label": "Button", "default": "Enter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Get notified" }
  ]
}
{% endschema %}
