{% comment %}
  Filter & sort bottom sheet — markup from collection.html. main.js owns the
  behaviour (client-side filtering over the bootstrapped catalog).

  {% render 'filter-sheet', vendors: collection.all_vendors, eyebrow: 'All products', section: section %}
{% endcomment %}
{%- assign s = section.settings -%}
<div class="sheet sheet--medium" id="filter-sheet" data-sheet aria-labelledby="filter-sheet-title">
  <div class="sheet__backdrop" data-sheet-close></div>
  <div class="sheet__panel" data-sheet-panel>
    <div class="sheet__grabber" aria-hidden="true"></div>
    <header class="sheet__header">
      <div>
        <p class="sheet__eyebrow" data-filter-eyebrow>{{ eyebrow | default: 'All products' }}</p>
        <h2 class="sheet__title" id="filter-sheet-title">{{ s.filter_label | default: 'Filter & sort' }}</h2>
      </div>
      <button class="sheet__close" type="button" aria-label="Close" data-sheet-close>
        <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </button>
    </header>
    <div class="sheet__body" data-filter-body>
      <div class="sheet-section">
        <p class="sheet-section__label">Sort by</p>
        <div class="sheet-list" role="radiogroup" aria-label="Sort by">
          {%- assign sorts = 'featured|Featured,newest|Newest,price-asc|Price — low to high,price-desc|Price — high to low' | split: ',' -%}
          {%- for pair in sorts -%}
            {%- assign bits = pair | split: '|' -%}
            <button type="button" class="sheet-list__row{% if forloop.first %} is-active{% endif %}" role="radio" aria-checked="{% if forloop.first %}true{% else %}false{% endif %}" data-filter-sort="{{ bits[0] }}">
              <span>{{ bits[1] }}</span>
              <svg class="sheet-list__row-check" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7.5L6 11L12 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          {%- endfor -%}
        </div>
      </div>

      {%- if s.show_brands and vendors.size > 0 -%}
      <div class="sheet-section">
        <p class="sheet-section__label">Brand</p>
        <div class="sheet-chips" data-filter-brands>
          {%- for vendor in vendors limit: 40 -%}
            <button type="button" class="sheet-chip" data-filter-brand="{{ vendor | escape }}">{{ vendor }}</button>
          {%- endfor -%}
        </div>
      </div>
      {%- endif -%}

      {%- if s.show_dept -%}
      <div class="sheet-section">
        <p class="sheet-section__label">Department</p>
        <div class="sheet-chips" role="radiogroup" aria-label="Department">
          <button type="button" class="sheet-chip is-selected" data-filter-dept="all">Everything</button>
          <button type="button" class="sheet-chip" data-filter-dept="men">Men</button>
          <button type="button" class="sheet-chip" data-filter-dept="women">Women</button>
        </div>
      </div>
      {%- endif -%}

      {%- if s.show_cats -%}
      <div class="sheet-section">
        <p class="sheet-section__label">Category</p>
        <div class="sheet-chips">
          <button type="button" class="sheet-chip" data-filter-cat="shoes">Footwear</button>
          <button type="button" class="sheet-chip" data-filter-cat="apparel">Apparel</button>
          <button type="button" class="sheet-chip" data-filter-cat="accessories">Accessories</button>
          <button type="button" class="sheet-chip" data-filter-cat="objects">Objects</button>
        </div>
      </div>
      {%- endif -%}

      {%- if s.show_price -%}
      <div class="sheet-section">
        <p class="sheet-section__label">Price</p>
        <div class="sheet-chips">
          {%- assign b1 = s.price_band_1 | default: 50 -%}
          {%- assign b2 = s.price_band_2 | default: 100 -%}
          {%- assign b3 = s.price_band_3 | default: 150 -%}
          <button type="button" class="sheet-chip" data-filter-price="0-{{ b1 }}">Under {{ b1 | times: 100 | money_without_trailing_zeros }}</button>
          <button type="button" class="sheet-chip" data-filter-price="{{ b1 }}-{{ b2 }}">{{ b1 | times: 100 | money_without_trailing_zeros }}–{{ b2 | times: 100 | money_without_trailing_zeros }}</button>
          <button type="button" class="sheet-chip" data-filter-price="{{ b2 }}-{{ b3 }}">{{ b2 | times: 100 | money_without_trailing_zeros }}–{{ b3 | times: 100 | money_without_trailing_zeros }}</button>
          <button type="button" class="sheet-chip" data-filter-price="{{ b3 }}-999999">{{ b3 | times: 100 | money_without_trailing_zeros }}+</button>
        </div>
      </div>
      {%- endif -%}

      {%- if s.show_sale -%}
      <div class="sheet-section">
        <label class="pref-toggle">
          <input type="checkbox" data-filter-sale />
          <span class="pref-toggle__track"><span class="pref-toggle__thumb"></span></span>
          Sale items only
        </label>
      </div>
      {%- endif -%}
    </div>
    <footer class="sheet__footer">
      <div class="btn-row">
        <button type="button" class="btn btn--ghost" data-filter-clear>Clear</button>
        <button type="button" class="btn btn--primary" data-sheet-close data-filter-apply>Show results</button>
      </div>
    </footer>
  </div>
</div>
