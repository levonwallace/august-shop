{% comment %}
  Prototype: js/catalog.js cardHtml()
  Keep class names identical so css/components.css continues to apply.
{% endcomment %}
<a
  class="product-card"
  data-swipe-card
  href="{{ product.url }}"
  data-product-id="{{ product.selected_or_first_available_variant.id }}"
  data-product-handle="{{ product.handle }}"
>
  <div class="product-card__media">
    {% if product.featured_image %}
      <img
        src="{{ product.featured_image | image_url: width: 800 }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="lazy"
        width="{{ product.featured_image.width }}"
        height="{{ product.featured_image.height }}"
      >
    {% endif %}
  </div>
  <div class="product-card__meta">
    <div class="product-card__brand">{{ product.vendor }}</div>
    <div class="product-card__title">{{ product.title }}</div>
    <div class="product-card__price">
      {% if product.compare_at_price > product.price %}
        <span class="price-was">{{ product.compare_at_price | money }}</span>
      {% endif %}
      {{ product.price | money }}
    </div>
  </div>
</a>
