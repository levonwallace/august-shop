{% comment %}
  One product → the JSON shape js/catalog.js expects (prototype PRODUCTS[]).
  Usage: {% render 'product-json', product: product %}
  Trailing comma is handled by the caller (catalog-json snippet).

  dept / cat / type come from tags first (dept:men, cat:shoes, type:sneakers),
  then product.type, then title heuristics. Staff only need to tag when the
  defaults are wrong.
{% endcomment %}
{%- liquid
  assign dept = ''
  assign cat = ''
  assign ptype = ''
  for tag in product.tags
    assign down = tag | downcase
    if down contains 'dept:'
      assign dept = down | remove: 'dept:' | strip
    elsif down contains 'cat:'
      assign cat = down | remove: 'cat:' | strip
    elsif down contains 'type:'
      assign ptype = down | remove: 'type:' | strip
    endif
  endfor

  assign title_down = product.title | downcase
  if dept == blank
    if title_down contains "women's" or title_down contains 'womens' or title_down contains 'women’s'
      assign dept = 'women'
    elsif title_down contains "men's" or title_down contains 'mens' or title_down contains 'men’s'
      assign dept = 'men'
    else
      assign dept = 'unisex'
    endif
  endif

  assign type_down = product.type | downcase
  if cat == blank
    if type_down contains 'shoe' or type_down contains 'sneaker' or type_down contains 'boot' or type_down contains 'sandal' or type_down contains 'footwear' or type_down contains 'slipper'
      assign cat = 'shoes'
    elsif type_down contains 'hat' or type_down contains 'cap' or type_down contains 'bag' or type_down contains 'sock' or type_down contains 'wallet' or type_down contains 'accessor' or type_down contains 'jewel' or type_down contains 'beanie' or type_down contains 'belt' or type_down contains 'eyewear' or type_down contains 'sunglass'
      assign cat = 'accessories'
    elsif type_down contains 'candle' or type_down contains 'incense' or type_down contains 'ceramic' or type_down contains 'book' or type_down contains 'vinyl' or type_down contains 'home' or type_down contains 'fragrance' or type_down contains 'gift' or type_down contains 'object' or type_down contains 'publication' or type_down contains 'skin'
      assign cat = 'objects'
    elsif type_down != blank
      assign cat = 'apparel'
    elsif title_down contains 'shoe' or title_down contains 'sneaker' or title_down contains 'boot' or title_down contains 'sandal' or title_down contains 'runner'
      assign cat = 'shoes'
    elsif title_down contains 'hat' or title_down contains 'cap' or title_down contains 'bag' or title_down contains 'sock' or title_down contains 'wallet' or title_down contains 'beanie'
      assign cat = 'accessories'
    else
      assign cat = 'apparel'
    endif
  endif

  assign sale = false
  if product.compare_at_price > product.price
    assign sale = true
  endif
  assign price = product.price | divided_by: 100.0
  assign compare = product.compare_at_price | divided_by: 100.0

  assign size_values = ''
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname == 'size' or oname == 'sizes' or oname == 'shoe size'
      assign size_values = option.values | join: '|'
    endif
  endfor
  if size_values == blank and product.has_only_default_variant == false
    assign size_values = product.options_with_values.first.values | join: '|'
  endif
  assign sizes = size_values | split: '|'
-%}
{
  "id": {{ product.id | json }},
  "variantId": {{ product.selected_or_first_available_variant.id | json }},
  "handle": {{ product.handle | json }},
  "url": {{ product.url | within: collection | json }},
  "title": {{ product.title | json }},
  "brand": {{ product.vendor | json }},
  "dept": {{ dept | json }},
  "cat": {{ cat | json }},
  {%- if ptype != blank %}"type": {{ ptype | json }},{% endif %}
  "sale": {{ sale }},
  "available": {{ product.available }},
  "price": {{ price }},
  "compare": {% if sale %}{{ compare }}{% else %}null{% endif %},
  "img": {% if product.featured_image %}{{ product.featured_image | image_url: width: 600 | json }}{% else %}""{% endif %},
  "images": [{% for image in product.images limit: 5 %}{{ image | image_url: width: 900 | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
  "sizes": {{ sizes | json }},
  "variants": [{% for variant in product.variants %}{"id": {{ variant.id | json }}, "title": {{ variant.title | json }}, "available": {{ variant.available }}, "price": {{ variant.price | divided_by: 100.0 }}}{% unless forloop.last %},{% endunless %}{% endfor %}],
  "body": {{ product.description | strip_html | truncate: 400 | json }}
}
