<main class="account-gate" id="main">
  <h1>Create account</h1>
  {% form 'create_customer' %}
    <label>Name <input type="text" name="customer[first_name]" autocomplete="name"></label>
    <label>Email <input type="email" name="customer[email]" autocomplete="email"></label>
    <label>Password <input type="password" name="customer[password]" autocomplete="new-password"></label>
    <button class="btn btn--primary" type="submit">Create account</button>
  {% endform %}
</main>
