<main class="account-gate" id="main">
  <h1>Reset password</h1>
  {% form 'reset_customer_password' %}
    <input type="password" name="customer[password]" autocomplete="new-password">
    <input type="password" name="customer[password_confirmation]" autocomplete="new-password">
    <button class="btn btn--primary" type="submit">Save</button>
  {% endform %}
</main>
