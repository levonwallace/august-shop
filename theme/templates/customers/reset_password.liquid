<main class="account-page" id="main">
  <div class="account-gate">
    <div class="glass-panel account-gate__card">
      <h1>Reset password</h1>
      <p class="account-gate__why">Choose a new password.</p>
      {%- form 'reset_customer_password', class: 'profile-form' -%}
        {%- if form.errors -%}
          <p class="profile-form__error" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <label class="profile-field">
          <span>New password</span>
          <input type="password" name="customer[password]" required minlength="8" autocomplete="new-password">
        </label>
        <label class="profile-field">
          <span>Confirm password</span>
          <input type="password" name="customer[password_confirmation]" required minlength="8" autocomplete="new-password">
        </label>
        <button class="btn btn--primary btn--block profile-form__submit" type="submit">Save password</button>
      {%- endform -%}
    </div>
  </div>
</main>
